# Production Environment Configuration
# This file contains production-specific environment variables

# API Configuration
# VITE_API_BASE_URL="https://api.scholarfinder.com"
#VITE_API_BASE_URL="http://10.1.0.103:3002"
#VITE_API_BASE_URL="https://scholarfinder.mpslimited.com"
#VITE_SCHOLARFINDER_API_URL="https://scholarfinder.mpslimited.com/api"
VITE_API_BASE_URL="http://172.30.3.30:3002"
#VITE_SCHOLARFINDER_API_URL="http://127.0.0.1:8000"
VITE_SCHOLARFINDER_API_URL="http://172.30.3.30:8000"
VITE_API_TIMEOUT="2400000"
VITE_API_RETRY_ATTEMPTS="3"
VITE_API_RETRY_DELAY="2000"

# File Upload Configuration
VITE_MAX_FILE_SIZE="52428800"
VITE_SUPPORTED_FILE_TYPES="docx,doc"
VITE_UPLOAD_CHUNK_SIZE="1048576"

# Authentication Configuration
VITE_JWT_STORAGE_KEY="scholarfinder_token"
VITE_TOKEN_REFRESH_THRESHOLD="300000"

# Feature Flags
VITE_ENABLE_DEV_TOOLS="false"
VITE_ENABLE_QUERY_DEVTOOLS="false"
VITE_ENABLE_DEBUG_LOGGING="false"
VITE_ENABLE_PERFORMANCE_MONITORING="false"

# Cache Configuration
VITE_CACHE_STALE_TIME="600000"
VITE_CACHE_GC_TIME="1800000"

# UI Configuration
VITE_PAGINATION_DEFAULT_SIZE="20"
VITE_TOAST_DURATION="4000"
VITE_DEBOUNCE_DELAY="300"

# Production-specific settings
VITE_ENABLE_API_MOCKING="false"